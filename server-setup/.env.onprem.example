# 양식 파일 (git 추적). 실제 값은 .env.onprem (git 제외)에 있다. 비운 키: PASSWORD, HF_TOKEN
# ============================================
# 온프레미스 운영계 .env — 같은 폴더에 .env로 복사해서 쓴다 (cp .env.onprem .env)
# setup-host.sh + docker-compose.yml + user.sh 공용
# ============================================

# 서버 종류: aws | onprem (start.sh pull 방식, 셋업 스크립트 오용 방지)
PLATFORM=onprem

# 환경 모드: dev | prd
MODE=prd

USERNAME=root
PASSWORD=
CONTAINER_UID=2000
CONTAINER_GID=2000

# ============================================
# 호스트 설정 (setup-host.sh에서 사용)
# ============================================

# 데이터 디스크 디바이스 (값을 넣으면 그 디스크를 xfs로 포맷·마운트한다)
# 연구_AI서버#1은 설치팀이 파일시스템(/appdata, /data, /model)을 만들어 주므로 비워 둔다
# ⚠️ 절대 루트 디바이스(/dev/nvme0n1, /dev/nvme0n1p1 등)를 넣지 말 것 — 데이터 손실 위험
VOLUME_DEVICE=
# 호스트 SSH 포트 (기본 22 대신 변경, firewalld·SELinux·fail2ban 동일 포트 적용)
SSH_PORT=5555
# firewalld 개방 컨테이너 포트 범위 (compose 5000-5009 + user.sh 5010-5499)
CONTAINER_PORT_RANGE=5000-5499

# NVIDIA 버전 고정 (setup-host.sh가 설치 후 dnf versionlock)
# 580 = LTSB, 2028-06까지 지원. 610은 NFB라 2026-08 종료 — 번호가 커도 쓰지 않는다
# 서버 구성 요청서(2026-11-06) 런타임 기준
NVIDIA_DRIVER_VERSION=580.196.07
NVIDIA_CONTAINER_TOOLKIT_VERSION=1.20.1-1
# Docker CE 버전 고정 (비우면 저장소 최신)
DOCKER_VERSION=29.9.3

# Docker GPU 테스트 이미지 (드라이버 580은 CUDA 12.x 이미지도 구동 — 하위 호환)
CUDA_TEST_IMAGE=nvidia/cuda:12.8.1-base-ubuntu24.04
# vLLM 베이스 이미지 (setup-host.sh Phase 2가 미리 pull — 폐쇄망 대비)
# 태그와 다이제스트를 함께 적는다(태그만 쓰면 빌드 때 다른 베이스가 올 수 있다).
# 버전을 바꾸면 Dockerfile.llm의 ARG VLLM_VERSION도 함께 바꾼다(다르면 빌드 첫 단계에서 멈춘다)
VLLM_IMAGE=vllm/vllm-openai:v0.31.0@sha256:c1c9f6fd5c109ba7f0546a59f5b2f15fb87f64c77782e90a27b648b42a8e67c3
# 빌드된 이미지 이름
LLM_IMAGE_NAME=llm-prd

# ============================================
# 경로 설정
# ============================================

# 작업공간·홈 경로 (setup-host.sh + docker-compose + user.sh 공용) — 사내 표준 /appdata
VOLUME_PATH=/appdata
# 모델·데이터 경로 — 요청서의 /model, /data (같은 3.84TB 디스크를 공유)
MODELS_PATH=/model
DATA_PATH=/data
# HuggingFace 토큰 (게이트 모델용)
HF_TOKEN=
# 추가 pip requirements 파일 경로 (컨테이너 내부 기준). 비워 둔다 — 서빙 의존성은 이미지 빌드 때 들어간다.
# 값을 주면 컨테이너가 뜰 때마다 빌드 때의 핵심 패키지 제약(vLLM·torch·transformers 등)을 걸어 설치한다(entrypoint-llm.sh)
# ⚠️ 폐쇄망: 값을 주면 매 기동마다 pip install 하므로 휠을 미리 받아둬야 한다 (SETUP_GUIDE.md §5-3)
EXTRA_REQUIREMENTS=

# ============================================
# 포트 설정
# ============================================

# 메인 컨테이너 SSH 포트 (호스트 → 컨테이너 5555)
LLM_SSH_PORT=5000
# 서비스용 포트 — 단일(5031) 또는 range(5001-5009)
LLM_EXTRA_PORTS=5031
# code-server 전용 포트 (LLM_EXTRA_PORTS 와 겹치지 않게 지정)
LLM_CODE_SERVER_PORT=5500

# ============================================
# 리소스 설정 (H200 4장, 호스트 RAM 512GB 기준)
# ============================================

# 컨테이너 메모리 — 호스트 RAM 512GB 중 OS·Docker 몫을 남긴다. 모델 로드 시 CPU RAM에 가중치를 한 번 올린다
LLM_MEMORY=384g
# 공유 메모리 (텐서 병렬 NCCL 통신) — GPU 장수에 비례해 키운다 (AWS 2장 16g → 4장 32g)
SHM_SIZE=32g
# GPU 할당 (all = 전체, 0,1 = 특정 GPU 번호)
LLM_GPUS=all

# ============================================
# 다중 사용자: ./user.sh 로 관리
#   sudo ./user.sh up prd-job --root --gpus all   # 운영 root 컨테이너
# 포트: docker-compose 메인 5000-5009, user.sh 5010-5499 (사용자당 10포트)
# ============================================
