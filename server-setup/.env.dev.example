# 양식 파일 (git 추적). 실제 값은 .env.dev (git 제외)에 있다. 비운 키: PASSWORD, HF_TOKEN
# ============================================
# 사용자 설정 (setup-ec2.sh + docker-compose 공용)
# ============================================

# 서버 종류: aws | onprem (start.sh pull 방식, 셋업 스크립트 오용 방지)
PLATFORM=aws

# 환경 모드: dev | prd
# - dev: nvm + Node + codex 빌드, Claude Code 자동 설치, 개발 도구 풀세트
# - prd: 위 항목 스킵 → 이미지 슬림화 (운영 EC2)
MODE=dev

USERNAME=user
PASSWORD=
CONTAINER_UID=2000
CONTAINER_GID=2000

# ============================================
# EC2 호스트 설정 (setup-ec2.sh에서 사용)
# ============================================

# EBS 볼륨 디바이스 (lsblk로 확인, 추가 EBS만 사용 — 예: /dev/nvme1n1)
# dev EC2는 데이터 영속화가 필요하므로 추가 EBS 권장. 빈값 폴백 시 인스턴스 종료와 함께 데이터 삭제됨
# ⚠️ 절대 루트 디바이스(/dev/nvme0n1, /dev/nvme0n1p1 등)를 넣지 말 것 — 데이터 손실 위험
VOLUME_DEVICE=
# EC2 호스트 SSH 포트 (기본 22 대신 변경)
SSH_PORT=5555
# Docker GPU 테스트 이미지
CUDA_TEST_IMAGE=nvidia/cuda:12.8.1-base-ubuntu24.04
# vLLM 베이스 이미지
# 태그와 다이제스트를 함께 적는다(태그만 쓰면 빌드 때 다른 베이스가 올 수 있다).
# 버전을 바꾸면 Dockerfile.llm의 ARG VLLM_VERSION도 함께 바꾼다(다르면 빌드 첫 단계에서 멈춘다)
VLLM_IMAGE=vllm/vllm-openai:v0.31.0@sha256:c1c9f6fd5c109ba7f0546a59f5b2f15fb87f64c77782e90a27b648b42a8e67c3
# 빌드된 이미지 이름 (dev/prd 분리)
LLM_IMAGE_NAME=llm-dev

# ============================================
# 경로 설정
# ============================================

# EBS 마운트 경로 (setup-ec2.sh + docker-compose 공용)
VOLUME_PATH=/volume
# HuggingFace 토큰 (게이트 모델용 — 서버 구성 시 입력)
HF_TOKEN=
# 추가 pip requirements 파일 경로 (컨테이너 내부 기준). 비워 둔다 — 서빙 의존성은 이미지 빌드 때 들어간다.
# 값을 주면 컨테이너가 뜰 때마다 빌드 때의 핵심 패키지 제약(vLLM·torch·transformers 등)을 걸어 설치한다(entrypoint-llm.sh)
EXTRA_REQUIREMENTS=

# ============================================
# 포트 설정 (서버 구성 시 충돌 회피용으로 직접 수정 가능, 기본 5000~5xxx)
# ============================================

# 메인 사용자 SSH 포트 (호스트 → 컨테이너 5555)
LLM_SSH_PORT=5000
# 서비스용 포트 (Jupyter, Tensorboard, vLLM API 등) — 단일(5031) 또는 range(5001-5009)
LLM_EXTRA_PORTS=5001-5009

# ============================================
# 리소스 설정 (서버 사양에 맞춰 조정 — 예시는 g6e.12xlarge 384GiB RAM)
# ============================================

# 컨테이너 메모리 (호스트 여유 확보)
LLM_MEMORY=48g
# 공유 메모리 (멀티GPU 통신용)
SHM_SIZE=16g
# GPU 할당 (all = 전체, 0,1 = 특정 GPU 번호)
LLM_GPUS=all

# ============================================
# 다중 사용자: ./user.sh 로 관리
#   ./user.sh up alice --gpus 0,1
#   ./user.sh up bob --password secret --gpus 2,3
#   ./user.sh list
#   ./user.sh down alice
# 포트: docker-compose 메인 5000-5009, user.sh 5010-5499 (사용자당 10포트)
# ============================================
