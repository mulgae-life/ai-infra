FROM nvidia/cuda:12.6.3-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive

# ============================================
# 시스템 패키지
# ============================================
RUN apt update && apt install -y \
    openssh-server sudo nano curl wget git \
    build-essential cmake \
    python3.12 python3-pip \
    htop tmux jq \
    bubblewrap \
    locales tzdata \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && ln -sf /usr/bin/pip3 /usr/bin/pip \
    && rm -rf /var/lib/apt/lists/*
RUN echo '[global]\nbreak-system-packages = true' > /etc/pip.conf

# ============================================
# 한글 로케일 + 서울 타임존
# ============================================
RUN locale-gen ko_KR.UTF-8 \
    && ln -sf /usr/share/zoneinfo/Asia/Seoul /etc/localtime
ENV LANG=ko_KR.UTF-8
ENV LC_ALL=ko_KR.UTF-8
# ENV는 docker exec에만 전달되고 sshd가 만드는 SSH 세션에는 넘어가지 않는다.
# LANG을 안 보내는 클라이언트(Termius 등)는 ASCII 로케일이 되어 tmux가 한글을 '_'로 그리므로
# sshd PAM이 읽는 /etc/default/locale에도 같은 값을 기록한다 (잘못된 값이면 빌드 실패)
RUN update-locale LANG="${LANG}"

# ============================================
# nvm + Node.js LTS
# ============================================
ENV NVM_DIR=/usr/local/nvm
RUN mkdir -p $NVM_DIR \
    && curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.4/install.sh | bash \
    && . $NVM_DIR/nvm.sh \
    && nvm install --lts \
    && nvm alias default lts/* \
    && ln -sf $(ls -td $NVM_DIR/versions/node/v* | head -1) $NVM_DIR/versions/node/default \
    && npm install -g pnpm yarn typescript
ENV PATH=$NVM_DIR/versions/node/default/bin:$PATH

# ============================================
# Python 패키지
# ============================================
RUN pip install --no-cache-dir \
    numpy numba cupy-cuda12x \
    matplotlib pytest ipython nvitop

# ============================================
# 사용자 생성 + 설정
# ============================================
ARG USERNAME=user
ARG PASSWORD=changeme
ARG UID=2000
ARG GID=2000
RUN existing_user=$(getent passwd ${UID} | cut -d: -f1 || true); \
    [ -n "$existing_user" ] && userdel -r "$existing_user" || true; \
    existing_group=$(getent group ${GID} | cut -d: -f1 || true); \
    [ -n "$existing_group" ] && groupdel "$existing_group" || true; \
    groupadd -g ${GID} ${USERNAME} || true; \
    useradd -m -s /bin/bash -u ${UID} -g ${GID} ${USERNAME} \
    && echo "${USERNAME}:${PASSWORD}" | chpasswd \
    && usermod -aG sudo ${USERNAME} \
    && su - ${USERNAME} -c "git config --global --add safe.directory /workspace && git config --global core.quotePath false" \
    && echo "set -g mouse on" > /home/${USERNAME}/.tmux.conf \
    && chown ${USERNAME}:${USERNAME} /home/${USERNAME}/.tmux.conf \
    && echo 'export NVM_DIR=/usr/local/nvm' >> /home/${USERNAME}/.bashrc \
    && echo '[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"' >> /home/${USERNAME}/.bashrc \
    && echo 'export PATH=/usr/local/cuda/bin:$PATH' >> /home/${USERNAME}/.bashrc \
    && echo 'export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH' >> /home/${USERNAME}/.bashrc \
    && echo 'export PATH="$HOME/.local/bin:$PATH"' >> /home/${USERNAME}/.bashrc \
    && chown -R ${USERNAME}:${USERNAME} /usr/local/nvm

# ============================================
# Claude Code + OpenAI Codex
# ============================================
RUN su - ${USERNAME} -c "curl -fsSL https://claude.ai/install.sh | bash"
RUN su - ${USERNAME} -c ". /usr/local/nvm/nvm.sh && npm install -g @openai/codex"

# ============================================
# 추가 도구 (2026-09 컨테이너 안에서 수동 설치하던 것을 이미지에 고정)
# ============================================
# 문서/미디어 처리: pandoc·latexdiff(TeX), poppler-utils·qpdf(PDF), imagemagick·librsvg2-bin(이미지), ffmpeg
# 한글 폰트: pandoc HTML·imagemagick·rsvg 출력에서 한글이 네모로 깨지지 않도록 (dev 와 동일 패키지)
# GPU 모니터링: nvtop
RUN apt update && apt install -y \
    ffmpeg imagemagick librsvg2-bin \
    pandoc latexdiff \
    poppler-utils qpdf \
    fonts-nanum fonts-noto-cjk \
    nvtop zip unzip \
    && rm -rf /var/lib/apt/lists/*
RUN su - ${USERNAME} -c ". /usr/local/nvm/nvm.sh && npm install -g @google/gemini-cli"

# 홈 디렉토리 초기 파일 백업 (bind mount 시 복원용)
RUN mkdir -p /etc/docker-home-init && cp -a /home/${USERNAME} /etc/docker-home-init/

# ============================================
# SSH 설정
# ============================================
RUN mkdir -p /run/sshd \
    && sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin no/' /etc/ssh/sshd_config \
    && sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config
# 브루트포스 대응 설정 (컨테이너 안에서 수동으로 넣었던 50-hardening.conf 를 이미지에 고정)
COPY sshd-hardening.conf /etc/ssh/sshd_config.d/50-hardening.conf
RUN echo "AllowUsers ${USERNAME}" >> /etc/ssh/sshd_config.d/50-hardening.conf

# ============================================
# 작업 디렉토리
# ============================================
WORKDIR /workspace
RUN chown -R ${USERNAME}:${USERNAME} /workspace

COPY entrypoint.sh /usr/local/bin/entrypoint.sh

EXPOSE 22 5001-5009

ENTRYPOINT ["entrypoint.sh"]
# -e: 컨테이너에 syslog 가 없으므로 sshd 로그를 표준 에러로 내보내 `docker logs cfd` 로 본다
CMD ["/usr/sbin/sshd", "-D", "-e"]
