ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# 환경 모드: dev (개발) | prd (운영)
# - dev: nvm + Node + codex 빌드 (Claude Code/codex 사용)
# - prd: 위 항목 스킵 → 이미지 슬림화
ARG MODE=dev

# 이 레포의 서빙 코드와 의존성은 vLLM 0.31.0 기준이다(게이트웨이 effort 처리, requirements 오디오 고정).
# .env의 VLLM_IMAGE를 바꾸지 않고 빌드하면 옛 베이스로 조용히 만들어지므로 첫 단계에서 멈춘다.
# 버전업 때는 .env*의 VLLM_IMAGE와 이 값을 함께 바꾼다. 비교는 로컬 표시(+cu130 등)를 뗀 버전으로 한다.
ARG VLLM_VERSION=0.31.0
RUN python3 -c 'import importlib.metadata as m, sys; v = m.version("vllm"); w = sys.argv[1]; \
sys.exit(0 if v.split("+")[0] == w else f"베이스 이미지의 vLLM {v} != {w}: .env의 VLLM_IMAGE를 vllm/vllm-openai:v{w}@sha256:... 로 바꾸세요")' \
    "$VLLM_VERSION"

ENV DEBIAN_FRONTEND=noninteractive

# ============================================
# 시스템 패키지
# ============================================
RUN apt-get update && apt-get install -y \
    openssh-server sudo git curl wget \
    build-essential ca-certificates \
    vim nano tmux htop jq \
    fzf ripgrep \
    bubblewrap \
    net-tools iputils-ping dnsutils \
    locales tzdata \
    # Playwright/Puppeteer headless Chrome 의존성
    libnspr4 libnss3 \
    libatk1.0-0 libatk-bridge2.0-0 libatspi2.0-0 \
    libxcomposite1 libxdamage1 \
    && rm -rf /var/lib/apt/lists/*

# python → 베이스가 쓰는 python3. v0.20.2 베이스는 /usr/local에 빌드한 Python, 0.31 런타임은
# apt의 /usr/bin/python3를 쓴다(공식 docker/Dockerfile 런타임 단계). 고정 경로로 링크하면
# 베이스가 바뀔 때 빈 대상을 가리키므로 실제 경로를 찾아 걸고, 못 찾으면 빌드를 멈춘다.
RUN PY3="$(command -v python3)" && [ -n "$PY3" ] && [ -x "$PY3" ] \
    && ln -sf "$PY3" /usr/bin/python && python --version

# ============================================
# 한글 로케일 + 서울 타임존
# ============================================
RUN locale-gen ko_KR.UTF-8 \
    && ln -sf /usr/share/zoneinfo/Asia/Seoul /etc/localtime \
    && echo "Asia/Seoul" > /etc/timezone
ENV LANG=ko_KR.UTF-8
ENV LC_ALL=ko_KR.UTF-8
# ENV는 docker exec에만 전달되고 sshd가 만드는 SSH 세션에는 넘어가지 않는다.
# LANG을 안 보내는 클라이언트(Termius 등)는 ASCII 로케일이 되어 tmux가 한글을 '_'로 그리므로
# sshd PAM이 읽는 /etc/default/locale에도 같은 값을 기록한다 (잘못된 값이면 빌드 실패)
RUN update-locale LANG="${LANG}"

# ============================================
# nvm + Node.js LTS + codex (dev 전용)
# - prd: 빌드 스킵 → 이미지 슬림화 (Claude Code/codex 미사용)
# ============================================
ENV NVM_DIR=/usr/local/nvm
RUN if [ "$MODE" = "dev" ]; then \
        mkdir -p $NVM_DIR \
        && curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.4/install.sh | bash \
        && . $NVM_DIR/nvm.sh \
        && nvm install --lts \
        && nvm alias default lts/* \
        && ln -sf $(ls -td $NVM_DIR/versions/node/v* | head -1) $NVM_DIR/versions/node/default \
        && npm install -g @openai/codex; \
    fi
# PATH는 dev/prd 공통 (prd 이미지엔 이 디렉토리가 없지만 셸이 비존재 경로를 무시하므로 무해)
ENV PATH=$NVM_DIR/versions/node/default/bin:$PATH

# ============================================
# 사용자 생성은 런타임(entrypoint)에서 처리
# Claude Code도 런타임에 사용자별 설치 (홈 bind mount 시 persist)
# ============================================

# ============================================
# SSH 설정
# ============================================
RUN mkdir -p /run/sshd \
    && printf "Port 5555\nPermitRootLogin no\nPasswordAuthentication yes\n" > /etc/ssh/sshd_config.d/custom.conf

# ============================================
# Python 패키지 (빌드 타임)
# ============================================
COPY requirements.txt /tmp/requirements.txt
COPY gen-core-constraints.py /opt/gen-core-constraints.py
# 베이스(vllm/vllm-openai v0.31.0)가 검증한 vLLM·torch·transformers·FlashInfer 조합을 그대로 쓰고
# 챗봇 의존성만 얹는다. Gemma 4 MTP는 0.21.0부터 정식 포함이라 nightly 휠 덮어쓰기는 없앴다.
#  ① 생성기 기본 모드: 베이스의 핵심 패키지를 배포 메타데이터 기준 == 제약으로 낸다(필수 누락 시 실패)
#  ② requirements.txt를 그 제약으로 설치 → 챗봇 의존성이 베이스 조합을 바꾸려 하면 빌드가 실패한다
#     (예전처럼 transformers를 하한만 두고 다시 깔면 0.31의 상한 5.18 미만을 넘을 수 있었다)
#  ③ pip check → ④ --final: FlashInfer 부속·음성 경로까지 최종 서빙 조합 확인(하나라도 없으면 실패)
#  ⑤ 최종 조합과 전체 목록을 이미지 안에 남긴다. 운영 빌드는 이 두 파일을 aws/image-freeze-0.31.0.txt와 대조
# pip는 python3 -m pip로 부른다: 0.31 런타임은 apt Python에 get-pip로 pip를 따로 깔아, 셸의 pip가
# 다른 인터프리터를 가리킬 여지를 없앤다
# 제약 파일은 /opt에 남긴다: 진입점이 EXTRA_REQUIREMENTS를 설치할 때도 같은 제약을 건다(entrypoint-llm.sh)
RUN python3 /opt/gen-core-constraints.py > /opt/vllm-core-constraints.txt \
    && python3 -m pip install --no-cache-dir -r /tmp/requirements.txt -c /opt/vllm-core-constraints.txt \
    && python3 -m pip check \
    && python3 /opt/gen-core-constraints.py --final > /opt/image-core-final.txt \
    && cat /opt/image-core-final.txt \
    && python3 -m pip freeze > /opt/image-freeze.txt

# ============================================
# CUDA 런타임 라이브러리 ldconfig 등록 (flashinfer JIT 대응)
# ============================================
# flashinfer는 sampling 커널을 런타임에 시스템 nvcc로 JIT 컴파일하는데, 그 산출물이
# libcudart.so.<major>를 동적 링크한다. 연구계(호스트)는 시스템 CUDA lib 경로가 ldconfig에
# 등록돼 있어 자동으로 찾지만, 컨테이너 베이스 이미지엔 이 등록이 빠져 있어
# profile_run 의 첫 sampler 커널 로드에서 "libcudart.so.13: cannot open shared object file"로
# EngineCore가 죽는다 (VRAM 점유까지는 성공한 뒤 여기서 실패).
# → 시스템 CUDA lib 경로를 ldconfig에 등록해 연구계와 동일하게 만든다. glob이라 CUDA 버전
#   무관(12.9면 so.12, 13.0이면 so.13을 그 환경에서 그대로 잡는다). 빌드 로그로 등록 확인.
RUN { for d in /usr/local/cuda*/targets/*/lib /usr/local/cuda*/lib64; do [ -d "$d" ] && echo "$d"; done; } \
        | sort -u > /etc/ld.so.conf.d/cuda-flashinfer.conf \
    && ldconfig \
    && echo "[ldconfig] registered cudart:" && ldconfig -p | grep -i cudart

# ============================================
# 작업 디렉토리
# ============================================
WORKDIR /workspace

COPY entrypoint-llm.sh /usr/local/bin/entrypoint-llm.sh
RUN chmod +x /usr/local/bin/entrypoint-llm.sh

EXPOSE 5555

ENTRYPOINT ["/usr/local/bin/entrypoint-llm.sh"]
CMD ["/usr/sbin/sshd", "-D"]
